# ==============================================================================
# MIRA (Medical Intelligent Response Assistant)
# Environment Configuration Template
# ==============================================================================

# Application Metadata
MIRA_ENV=development
MIRA_DEBUG=true
MIRA_HOST=0.0.0.0
MIRA_PORT=8000
MIRA_VERSION=0.1.0

# Security & Secret Keys
MIRA_SECRET_KEY=change-this-in-production-mira-secret-key-32chars

# Safety & Compliance Flags
MIRA_STRICT_SAFETY_MODE=true
MIRA_EMERGENCY_ESCALATION_ENABLED=true
MIRA_DISCLAIMER_ENFORCEMENT=true

# AI Brain & LLM Service (Future Integration Configuration)
# Note: MIRA is built block-by-block. These hooks are foundational.
MIRA_LLM_PROVIDER=mock
MIRA_LLM_API_KEY=
MIRA_LLM_MODEL=gemini-2.5-flash

# Voice & Character Service
MIRA_VOICE_ID=mira-caring-nurse-v1
MIRA_VOICE_SAMPLE_RATE=24000
